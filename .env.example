# Database Configuration
DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432

# Service Database Names
AUTH_DB_NAME=auth_db
USER_DB_NAME=user_db
COURSE_DB_NAME=course_db
CONTENT_DB_NAME=content_db
ENROLLMENT_DB_NAME=enrollment_db
PAYMENT_DB_NAME=payment_db
REVIEW_DB_NAME=review_db
NOTIFICATION_DB_NAME=notification_db
ANALYTICS_DB_NAME=analytics_db
ADMIN_DB_NAME=admin_db

# JWT — generate with: openssl rand -base64 64
JWT_SECRET=replace_with_base64_encoded_secret

# Elasticsearch
ELASTICSEARCH_URIS=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Eureka
EUREKA_URI=http://localhost:8761/eureka/

# Content Storage
STORAGE_PATH=/app/uploads
STORAGE_BASE_URL=http://localhost:8084

# API Gateway / CORS (comma-separated for multiple origins)
ALLOWED_ORIGINS=http://localhost:5173

# Stripe — get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_SUCCESS_URL=http://localhost:5173/payment/success
STRIPE_CANCEL_URL=http://localhost:5173/payment/cancel

# Spring Profile (dev | prod)
SPRING_PROFILES_ACTIVE=dev
